classTweaker v2 named
# Fabric counterpart of META-INF/accesstransformer.cfg (NeoForge); keep the two in step.
# Client advancement progress (read-only access for the advancements tool)
accessible field net/minecraft/client/multiplayer/ClientAdvancements progress Ljava/util/Map;
# Player statistics map
accessible field net/minecraft/stats/StatsCounter stats Lit/unimi/dsi/fastutil/objects/Object2IntMap;
# Boss bars, titles and action bar text for the hud tool
accessible field net/minecraft/client/gui/components/BossHealthOverlay events Ljava/util/Map;
